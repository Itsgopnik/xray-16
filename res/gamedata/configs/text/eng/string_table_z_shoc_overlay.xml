<?xml version='1.0' encoding="UTF-8"?>
<!--
    SHoC-mode overlay string table for OpenXRay's CoP UI code paths.
    Loaded by CStringTable::Init (StringTable.cpp:60) which scans
    text/<lang>/*.xml. SHoC archives don't contain these CoP-only keys,
    so the engine showed them raw in the PDA. Last-write-wins per key —
    safe to coexist with SHoC's bundled string tables.
-->
<string_table>

    <!-- PDA Diary / Contacts. CoP code (UILogsWnd.cpp:115-120) reads the literal
         text from <center_caption> in XML, appends this string, and re-sets it.
         There is NO actor-name substitution, so we drop the "'s" prefix. -->
    <string id="ui_logs_center_caption">
        <text>Diary</text>
    </string>

    <!-- PDA Ranking (UIRankingWnd.cpp:128-134) — same mechanism as logs. -->
    <string id="ui_ranking_center_caption">
        <text>Ranking</text>
    </string>

    <!-- PDA Logs filter checkboxes (pda_logs.xml filter_news/_talk) -->
    <string id="pda_filter_news">
        <text>News</text>
    </string>
    <string id="pda_filter_talk">
        <text>Conversations</text>
    </string>
    <string id="pda_date_filter">
        <text>Date:</text>
    </string>

    <!-- PDA Ranking character info labels (pda_ranking.xml *_caption) -->
    <string id="ui_inv_rank">
        <text>Rank:</text>
    </string>
    <string id="ui_inv_community">
        <text>Faction:</text>
    </string>
    <string id="ui_inv_reputation">
        <text>Reputation:</text>
    </string>
    <string id="ui_inv_money">
        <text>Money:</text>
    </string>

    <!-- Fallback variants without the ui_ prefix (engine sometimes strips it) -->
